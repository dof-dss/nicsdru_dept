{#
/**
 * @file
 * Template for the Ajax Content block.
 *
 * @title "Default content"
 * Available variables:
 * - items: List of item arrays returned from the JSON API endpoint.
 *   Fields vary by endpoint — render what the template needs with |raw
 *   for pre-rendered HTML values, or escape plain-text values normally.
 * - view_all_url: URL string for the "More" link, or null if hidden.
 */
#}
{% if items %}
  <ul class="ajax-content-list">
    {% for item in items %}
      <li class="ajax-content-list__item">
        <span class="ajax-content-list__title">{{ item.title|raw }}</span>
      </li>
    {% endfor %}
  </ul>

  {% if view_all_url %}
    <p class="ajax-content-list__more">
      <a href="{{ view_all_url }}">{{ 'More...'|t }}</a>
    </p>
  {% endif %}
{% endif %}

<?php

/**
 * @file
 * Primary module hooks for Department Ajax Content module.
 */

/**
 * Implements hook_theme().
 *
 * Registers a theme hook for every .html.twig file in the templates directory.
 * Adding a new template file and rebuilding the cache is all that is needed to
 * make it available as a block template option.
 *
 * Hook names follow the pattern dept_ajax_content__{template_name}, where
 * hyphens in the filename are replaced with underscores.
 */
function dept_ajax_content_theme(): array {
  $hooks = [];

  foreach (glob(__DIR__ . '/templates/*.html.twig') as $file) {
    $template = basename($file, '.html.twig');
    $hook = 'dept_ajax_content__' . str_replace('-', '_', $template);
    $hooks[$hook] = [
      'variables' => [
        'items' => [],
        'view_all_url' => NULL,
      ],
      'template' => $template,
    ];
  }

  return $hooks;
}

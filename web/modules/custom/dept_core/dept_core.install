<?php

use Drupal\Core\Database\Database;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\path_alias\Entity\PathAlias;
use Drupal\path_alias\PathAliasInterface;

/**
 * Add weight to Department entity
 */
function dept_core_update_8001() {
  $field_storage_definition = BaseFieldDefinition::create('integer')
    ->setLabel(t('Weight'))
    ->setDescription(t('The weight/order of this Department'))
    ->setDefaultValue(0);

  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('weight', 'department', 'dept_core', $field_storage_definition);
}


/**
 * Remove Link node path alias entities.
 */
function dept_core_update_8002() {
  $conn = Database::getConnection();

  $alias_ids = $conn->query("SELECT pa.id FROM {path_alias} pa JOIN {node_field_data} nfd ON nfd.nid = SUBSTR(pa.path, (LENGTH('/node/') +1), LENGTH(pa.path)) WHERE nfd.type = :content_type", [':content_type' => 'link'])->fetchCol();

  if (!empty($alias_ids)) {
    foreach ($alias_ids as $alias_id) {
      $alias = PathAlias::load($alias_id);
      if ($alias instanceof PathAliasInterface) {
        $alias->delete();
      }
    }
  }
}

function  dept_core_update_8003() {
  // Intentionally empty. Updates in dept_core.deploy.php.
}

/**
 * Ensure the bid column of the batch table uses auto-increment.
 */
function dept_core_update_8004(): string {
  $connection = Database::getConnection();

  $column = $connection->query(
    'SELECT COLUMN_TYPE, EXTRA FROM information_schema.COLUMNS
     WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = :table AND COLUMN_NAME = :column',
    [':table' => $connection->prefixTables('{batch}'), ':column' => 'bid']
  )->fetchObject();

  if ($column && str_contains(strtolower((string) $column->EXTRA), 'auto_increment')) {
    return (string) t('The bid column of the batch table already uses auto-increment.');
  }

  // Auto-increment columns must be a key, so make sure bid is the primary key.
  $primary_key = $connection->query(
    'SELECT COUNT(*) FROM information_schema.STATISTICS
     WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = :table AND INDEX_NAME = :index',
    [':table' => $connection->prefixTables('{batch}'), ':index' => 'PRIMARY']
  )->fetchField();

  if (!$primary_key) {
    $connection->query('ALTER TABLE {batch} ADD PRIMARY KEY (bid)');
  }

  // Keep the existing column type (e.g. int unsigned), only add the flag.
  $type = $column ? $column->COLUMN_TYPE : 'int unsigned';
  $connection->query("ALTER TABLE {batch} MODIFY bid $type NOT NULL AUTO_INCREMENT");

  return (string) t('The bid column of the batch table now uses auto-increment.');
}

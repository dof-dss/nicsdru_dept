<?php

/**
 * @file
 * Book admendments for Departmental sites.
 */

use Drupal\Component\Utility\NestedArray;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\flag\FlagInterface;
use Drupal\node\Entity\NodeType;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_access().
 */
function dept_book_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($operation !== 'delete' || !$entity instanceof NodeInterface) {
    return AccessResult::neutral();
  }

  if (\Drupal::service('dept_book.parent_page_protection')->isProtected($entity, $account)) {
    return AccessResult::forbidden('Book pages with children must not be deleted.')
      ->cachePerPermissions()
      ->addCacheableDependency($entity);
  }

  return AccessResult::neutral()->cachePerPermissions()->addCacheableDependency($entity);
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function dept_book_node_presave(NodeInterface $node) {
  if ($node->isNew() || !$node->hasField('moderation_state')) {
    return;
  }

  $original_state = NULL;
  if (!empty($node->original) && $node->original instanceof NodeInterface && $node->original->hasField('moderation_state')) {
    $original_state = $node->original->get('moderation_state')->getString();
  }

  $protection = \Drupal::service('dept_book.parent_page_protection');
  if ($protection->isArchiveBlocked($node, \Drupal::currentUser(), $node->get('moderation_state')->getString(), $original_state)) {
    throw new EntityStorageException('Book pages with children must not be archived. Move or remove the child pages first.');
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function dept_book_form_node_form_alter(array &$form, FormStateInterface $form_state) {
  $node = dept_book_get_form_node($form_state);
  if ($node instanceof NodeInterface && \Drupal::service('dept_book.parent_page_protection')->isProtected($node, \Drupal::currentUser())) {
    unset($form['moderation_state']['widget'][0]['state']['#options']['archived']);
  }

  $form['#validate'][] = 'dept_book_validate_parent_page_archive';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function dept_book_form_moderation_sidebar_quick_transition_form_alter(array &$form, FormStateInterface $form_state) {
  $form['#validate'][] = 'dept_book_validate_moderation_sidebar_archive';
}

/**
 * Prevents a node form from archiving a protected book parent page.
 */
function dept_book_validate_parent_page_archive(array &$form, FormStateInterface $form_state) {
  $node = dept_book_get_form_node($form_state);
  if (!$node instanceof NodeInterface || !$node->hasField('moderation_state')) {
    return;
  }

  $new_state = $form_state->getValue('moderation_state');
  if (is_array($new_state)) {
    $new_state = $new_state[0]['value'] ?? NULL;
  }
  $original_state = $node->get('moderation_state')->getString();

  $protection = \Drupal::service('dept_book.parent_page_protection');
  if (is_string($new_state) && $protection->isArchiveBlocked($node, \Drupal::currentUser(), $new_state, $original_state)) {
    $form_state->setErrorByName('moderation_state', t('This book page has child pages and cannot be archived. Move or remove the child pages first.'));
  }
}

/**
 * Prevents the moderation sidebar from archiving a protected book parent.
 */
function dept_book_validate_moderation_sidebar_archive(array &$form, FormStateInterface $form_state) {
  $node = $form_state->get('entity');
  $trigger = $form_state->getTriggeringElement();
  if (!$node instanceof NodeInterface || empty($trigger['#id'])) {
    return;
  }

  $transitions = \Drupal::service('content_moderation.state_transition_validation')
    ->getValidTransitions($node, \Drupal::currentUser());
  $transition = $transitions[$trigger['#id']] ?? NULL;
  if ($transition === NULL || $transition->to()->id() !== 'archived') {
    return;
  }

  $original_state = $node->get('moderation_state')->getString();
  $protection = \Drupal::service('dept_book.parent_page_protection');
  if ($protection->isArchiveBlocked($node, \Drupal::currentUser(), 'archived', $original_state)) {
    $form_state->setError($trigger, t('This book page has child pages and cannot be archived. Move or remove the child pages first.'));
  }
}

/**
 * Gets the node entity from an entity form.
 */
function dept_book_get_form_node(FormStateInterface $form_state): ?NodeInterface {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return NULL;
  }

  $entity = $form_object->getEntity();
  return $entity instanceof NodeInterface ? $entity : NULL;
}

/**
 * Implements hook_entity_operation_alter().
 */
function dept_book_entity_operation_alter(array &$operations, EntityInterface $entity) {
  if (!$entity instanceof NodeInterface || !\Drupal::service('dept_book.parent_page_protection')->isProtected($entity, \Drupal::currentUser())) {
    return;
  }

  unset($operations['delete'], $operations['change_to_archived']);
}

/**
 * Implements hook_entity_view_alter().
 */
function dept_book_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if (!$entity instanceof NodeInterface || !\Drupal::service('dept_book.parent_page_protection')->isProtected($entity, \Drupal::currentUser())) {
    return;
  }

  unset($build['actions']['primary']['archive']);
  $build['#cache']['contexts'][] = 'user.permissions';
}

/**
 * Implements hook_module_implements_alter().
 */
function dept_book_module_implements_alter(array &$implementations, $hook) {
  // The archive action is added by origins_workflow_entity_view_alter(), so
  // this module must run afterwards to remove it for protected book parents.
  if ($hook === 'entity_view_alter' && isset($implementations['dept_book'])) {
    $group = $implementations['dept_book'];
    unset($implementations['dept_book']);
    $implementations['dept_book'] = $group;
  }
}

/**
 * Implements hook_entity_presave().
 */
function dept_book_entity_presave(EntityInterface $entity) {
  if ($entity instanceof NodeType) {
    $book = $entity->book ?? NULL;

    if (empty($book)) {
      return;
    }
    else {
      /* @var \Drupal\flag\FlagServiceInterface $flag_service */
      $flag_service = \Drupal::service('flag');
      /* @var \Drupal\flag\FlagCountManagerInterface $flag_count_service */
      $flag_count_service = \Drupal::service('flag.count');

      // Has the node already had the ToC flag set? If so, nothing to do.
      $flags = $flag_count_service->getEntityFlagCounts($entity);
      if (array_key_exists('disable_toc', $flags) && $flags['disable_toc'] == 1) {
        return;
      }

      $toc_flag = $flag_service->getFlagById('disable_toc');

      // Flag the content to disable the toc.
      if ($toc_flag instanceof FlagInterface) {
        $flag_service->flag($toc_flag, $entity);
      }
    }
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function dept_book_entity_type_alter(array &$entity_types) {
  // Remove BookOutlineConstraint to permit outline changes to
  // nodes/books regardless of publish status.
  /* @var \Drupal\Core\Entity\ContentEntityTypeInterface $node_entity_type */
  $node_entity_type = &$entity_types['node'];
  $constraints = $node_entity_type->getConstraints();

  if (array_key_exists('BookOutline', $constraints)) {
    unset($constraints['BookOutline']);
    $node_entity_type->setConstraints($constraints);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function dept_book_node_update(EntityInterface $entity) {
  if ($entity instanceof NodeInterface === FALSE) {
    return;
  }

  $book = $entity->book ?? NULL;

  if (empty($book)) {
    return;
  }

  if ($book['bid'] === $book['nid']) {
    /* @var \Drupal\flag\FlagServiceInterface $flag_service */
    $flag_service = \Drupal::service('flag');
    /* @var \Drupal\flag\FlagCountManagerInterface $flag_count_service */
    $flag_count_service = \Drupal::service('flag.count');

    // Has the node already had the ToC flag set? If so, nothing to do.
    $flags = $flag_count_service->getEntityFlagCounts($entity);
    if (array_key_exists('disable_toc', $flags) && $flags['disable_toc'] == 1) {
      return;
    }

    $toc_flag = $flag_service->getFlagById('disable_toc');

    // Flag the content to disable the toc.
    if ($toc_flag instanceof FlagInterface) {
      $flag_service->flag($toc_flag, $entity);
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function dept_book_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Interject in the book outline form. Purge cache items
  // from affected book ids and associated node id cache entries.
  if (preg_match('/book_(outline|remove)/', $form_id)) {

    if (NestedArray::keyExists($form, ['actions', 'submit', '#submit'])) {
      array_unshift($form['actions']['submit']['#submit'], 'dept_book_process_topics');
    }

    $form['#submit'][] = 'dept_book_process_topics';

    if (!str_contains($form_id, 'ajax')) {
      $form['#submit'][] = 'dept_book_structure_change_cache_clear';
    }
  }
}

/**
 * Callback to process topics for book content.
 *
 * Entities will also be processed from the dept_topics module.
 *
 * @see \Drupal\dept_topics\TopicManager.php
 * @see \Drupal\dept_topics\dept_topics.module
 */
function dept_book_process_topics(array $form, FormStateInterface $form_state) {
  $values = $form_state->getValues();

  // Add the entity back into the child content field for each topic for
  // that entity's site topics values.
  if ($form['#form_id'] === 'book_remove_form') {
    $entity = \Drupal::routeMatch()->getParameter('node');
    if ($entity->hasField('field_site_topics')) {
      $topic_manager = \Drupal::service('topic.manager');
      $topic_manager->updateChildDisplayOnTopics($entity);
    }
  }

  // If the entity is not the parent item of the book, remove it from the child
  // content field for each topic in the entity's site topics values.
  // TL:DR; Hide child pages from topic/subtopic pages.
  if ($values['book']['nid'] !== $values['book']['bid']) {
    $entity = dept_book_get_form_node($form_state);
    if ($entity instanceof NodeInterface && $entity->hasField('field_site_topics')) {
      $topic_manager = \Drupal::service('topic.manager');
      $topic_manager->removeChildDisplayFromTopics($entity);
    }
  }
}

/**
 * Form submit callback used to purge cache items
 * for books and the node being affected.
 */
function dept_book_structure_change_cache_clear(&$form, FormStateInterface $form_state) {
  $book = $form_state->get('book') ?? [];
  $cache_tags = [];

  if (!empty($book['book'])) {
    $cache_tags[] = 'bid:' . $book['book']['bid'];
    $cache_tags[] = 'node:' . $book['book']['nid'];
  }

  Cache::invalidateTags($cache_tags);
}

/**
 * Implements hook_preprocess_book_navigation().
 */
function dept_book_preprocess_book_navigation(&$variables) {
  // Set some top level tags we can use to expire whenever
  // a book outline is changed or a node removed from a book.
  $variables['#cache']['tags'] = [
    'bid:' . $variables['book_link']['bid'],
    'node:' . $variables['book_link']['nid'],
  ];
}

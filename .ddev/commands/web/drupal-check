#!/usr/bin/env bash

## Description: Run phpstan against the current directory and all subdirectories.
## Usage: drupal-check [phpstan options]
## Aliases: drck
## Example: "cd web/modules/custom/dept_topics && ddev drupal-check" or "ddev drupal-check --error-format=raw"
## HostWorkingDir: true

# HostWorkingDir puts us in the container path matching the host directory.
/var/www/html/vendor/bin/phpstan analyse --memory-limit=2G "$@" "$PWD"
